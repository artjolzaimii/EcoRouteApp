// EcoRoute Prisma Schema — Supabase PostgreSQL
// Run: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  PARTNER
}

// ── Marketplace enums ──────────────────────────────────────────────────────────

enum ListingType {
  PRODUCT
  SERVICE
}

enum ListingPaymentType {
  MONEY_ONLY
  FLEXIBLE
}

enum ListingStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  INACTIVE
}

enum MarketplaceOrderStatus {
  PENDING
  SIMULATED_PAID
  COMPLETED
  CANCELLED
}

enum TripMode {
  WALKING
  CYCLING
  TRANSIT
  CYCLING_TRANSIT
  EV
}

enum TripStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PartnerCategory {
  FOOD
  RETAIL
  TRANSPORT
  FITNESS
  WELLNESS
  ENTERTAINMENT
  OTHER
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum PartnerType {
  MOBILITY_PROVIDER
  ECO_BUSINESS

  @@map("partner_type")
}

enum VehicleType {
  BICYCLE
  EBIKE
  ESCOOTER
  CARGO_BIKE

  @@map("vehicle_type")
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_ITEM
}

enum EarnType {
  TRIP_COMPLETE
  STREAK
  BADGE
  REFERRAL
  ADMIN_GRANT
  COUPON_REDEEM
  PARTNER_VISIT
  CHALLENGE_COMPLETE
}

enum ChallengeType {
  TRIP_COUNT // complete N trips (any mode)
  DISTANCE_KM // travel N km total
  CO2_SAVED_G // save N grams of CO2 vs car
  CYCLING_KM // cycle N km (CYCLING mode only)
}

enum ConditionType {
  MIN_DISTANCE_KM
  MIN_TRIPS
  STREAK_DAYS
  SPECIFIC_MODE
  FIRST_TRIP
  PARTNER_VISIT
}

enum PointsLedgerType {
  EARN
  REDEEM
  ADJUSTMENT
  EXPIRE
}

// ─────────────────────────────────────────────
// Profile
// ─────────────────────────────────────────────

model Profile {
  id         String   @id @default(cuid())
  authUserId String   @unique @map("auth_user_id") // Supabase auth.users UUID
  email      String   @unique
  fullName   String   @map("full_name")
  avatarUrl  String?  @map("avatar_url")
  role       Role     @default(USER)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  stats             UserStats?
  trips             Trip[]
  userCoupons       UserCoupon[]
  userBadges        UserBadge[]
  userChallenges    UserChallenge[]
  pointsLedger      PointsLedger[]
  notifications     Notification[]
  savedRoutes       SavedRoute[]
  partnerProfile    PartnerProfile?
  marketplaceOrders MarketplaceOrder[]

  @@map("profiles")
}

// ─────────────────────────────────────────────
// UserStats
// ─────────────────────────────────────────────

model UserStats {
  id              String    @id @default(cuid())
  profileId       String    @unique @map("profile_id")
  totalPoints     Int       @default(0) @map("total_points")
  totalTrips      Int       @default(0) @map("total_trips")
  totalDistanceKm Decimal   @default(0) @map("total_distance_km") @db.Decimal(10, 2)
  totalCo2SavedG  Int       @default(0) @map("total_co2_saved_g") // grams
  currentStreak   Int       @default(0) @map("current_streak")
  longestStreak   Int       @default(0) @map("longest_streak")
  lastTripAt      DateTime? @map("last_trip_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// ─────────────────────────────────────────────
// Trip
// ─────────────────────────────────────────────

model Trip {
  id              String     @id @default(cuid())
  profileId       String     @map("profile_id")
  mode            TripMode
  status          TripStatus @default(ACTIVE)
  originLat       Decimal    @map("origin_lat") @db.Decimal(10, 7)
  originLng       Decimal    @map("origin_lng") @db.Decimal(10, 7)
  destLat         Decimal    @map("dest_lat") @db.Decimal(10, 7)
  destLng         Decimal    @map("dest_lng") @db.Decimal(10, 7)
  originAddress   String     @map("origin_address")
  destAddress     String     @map("dest_address")
  distanceKm      Decimal    @map("distance_km") @db.Decimal(10, 2)
  durationMinutes Int        @map("duration_minutes")
  co2SavedG       Int        @default(0) @map("co2_saved_g") // grams saved vs car
  co2EmittedG     Int        @default(0) @map("co2_emitted_g") // grams emitted
  ecoScore        Int        @default(0) @map("eco_score") // 0-100
  pointsEarned    Int        @default(0) @map("points_earned")
  completedAt     DateTime?  @map("completed_at")
  createdAt       DateTime   @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([completedAt])
  @@map("trips")
}

// ─────────────────────────────────────────────
// EcoPartner
// ─────────────────────────────────────────────

model EcoPartner {
  id             String          @id @default(cuid())
  name           String
  description    String
  category       PartnerCategory
  status         PartnerStatus   @default(ACTIVE)
  logoUrl        String?         @map("logo_url")
  address        String
  lat            Decimal         @db.Decimal(10, 7)
  lng            Decimal         @db.Decimal(10, 7)
  radiusMeters   Int             @default(500) @map("radius_meters")
  websiteUrl     String?         @map("website_url")
  pointsPerVisit Int             @default(0) @map("points_per_visit")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  partnerType PartnerType @default(ECO_BUSINESS) @map("partner_type")

  coupons   Coupon[]
  analytics PartnerAnalytics[]
  locations PartnerLocation[]

  @@map("eco_partners")
}

// ─────────────────────────────────────────────
// PartnerLocation
// ─────────────────────────────────────────────

model PartnerLocation {
  id           String       @id @default(cuid())
  partnerId    String       @map("partner_id")
  externalId   String?      @map("external_id")
  name         String?
  lat          Decimal      @db.Decimal(10, 7)
  lng          Decimal      @db.Decimal(10, 7)
  vehicleCount Int?         @map("vehicle_count")
  vehicleType  VehicleType? @map("vehicle_type")
  isActive     Boolean      @default(true) @map("is_active")
  lastSyncedAt DateTime?    @map("last_synced_at")
  partner      EcoPartner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, externalId])
  @@map("partner_locations")
}

// ─────────────────────────────────────────────
// Airport
// ─────────────────────────────────────────────

model Airport {
  id           String  @id @default(cuid())
  iataCode     String  @unique @map("iata_code")
  name         String
  city         String?
  country      String?
  latitudeDeg  String  @map("latitude_deg")
  longitudeDeg String  @map("longitude_deg")
  type         String

  @@map("airports")
}

// ─────────────────────────────────────────────
// Coupon
// ─────────────────────────────────────────────

model Coupon {
  id             String         @id @default(cuid())
  partnerId      String         @map("partner_id")
  title          String
  description    String
  discountType   DiscountType   @map("discount_type")
  discountValue  Decimal        @map("discount_value") @db.Decimal(10, 2)
  pointsCost     Int            @default(0) @map("points_cost")
  conditionType  ConditionType? @map("condition_type")
  conditionValue String?        @map("condition_value") // JSON-serialised value
  totalStock     Int?           @map("total_stock")
  issuedCount    Int            @default(0) @map("issued_count")
  expiresAt      DateTime?      @map("expires_at")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")

  partner     EcoPartner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userCoupons UserCoupon[]

  @@map("coupons")
}

// ─────────────────────────────────────────────
// UserCoupon
// ─────────────────────────────────────────────

model UserCoupon {
  id         String    @id @default(cuid())
  profileId  String    @map("profile_id")
  couponId   String    @map("coupon_id")
  code       String    @unique
  redeemedAt DateTime? @map("redeemed_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("user_coupons")
}

// ─────────────────────────────────────────────
// Badge
// ─────────────────────────────────────────────

model Badge {
  id             String        @id @default(cuid())
  name           String        @unique
  description    String
  iconUrl        String?       @map("icon_url")
  conditionType  ConditionType @map("condition_type")
  conditionValue String        @map("condition_value") // JSON
  pointsReward   Int           @default(0) @map("points_reward")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badges")
}

// ─────────────────────────────────────────────
// UserBadge
// ─────────────────────────────────────────────

model UserBadge {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  badgeId   String   @map("badge_id")
  earnedAt  DateTime @default(now()) @map("earned_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  badge   Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([profileId, badgeId])
  @@map("user_badges")
}

// ─────────────────────────────────────────────
// PointsLedger  (append-only)
// ─────────────────────────────────────────────

model PointsLedger {
  id           String           @id @default(cuid())
  profileId    String           @map("profile_id")
  type         PointsLedgerType
  earnType     EarnType?        @map("earn_type")
  delta        Int // positive = earn, negative = redeem/expire
  balanceAfter Int              @map("balance_after")
  description  String
  refId        String?          @map("ref_id") // tripId, couponId, badgeId, etc.
  createdAt    DateTime         @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
  @@map("points_ledger")
}

// ─────────────────────────────────────────────
// Challenge
// ─────────────────────────────────────────────

model Challenge {
  id           String        @id @default(cuid())
  title        String
  description  String
  type         ChallengeType
  targetValue  Float         @map("target_value")
  modeFilter   TripMode?     @map("mode_filter") // only used by CYCLING_KM
  rewardPoints Int           @map("reward_points")
  startsAt     DateTime      @default(now()) @map("starts_at")
  endsAt       DateTime?     @map("ends_at")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")

  userChallenges UserChallenge[]

  @@map("challenges")
}

// ─────────────────────────────────────────────
// UserChallenge
// ─────────────────────────────────────────────

model UserChallenge {
  id          String    @id @default(cuid())
  profileId   String    @map("profile_id")
  challengeId String    @map("challenge_id")
  progress    Float     @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([profileId, challengeId])
  @@index([profileId])
  @@map("user_challenges")
}

// ─────────────────────────────────────────────
// PartnerAnalytics
// ─────────────────────────────────────────────

model PartnerAnalytics {
  id              String   @id @default(cuid())
  partnerId       String   @map("partner_id")
  date            DateTime @db.Date
  pinViews        Int      @default(0) @map("pin_views")
  pinClicks       Int      @default(0) @map("pin_clicks")
  couponsIssued   Int      @default(0) @map("coupons_issued")
  couponsRedeemed Int      @default(0) @map("coupons_redeemed")

  partner EcoPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, date])
  @@map("partner_analytics")
}

// ─────────────────────────────────────────────
// Notification
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  refType   String?  @map("ref_type") // badge | coupon | trip | points
  refId     String?  @map("ref_id")
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// SavedRoute
// ─────────────────────────────────────────────

model SavedRoute {
  id        String @id @default(cuid())
  profileId String @map("profile_id")

  // Human-readable addresses
  originAddress String @map("origin_address")
  destAddress   String @map("dest_address")

  // Coordinates (rounded to 5 decimal places on insert for dedup)
  originLat Float @map("origin_lat")
  originLng Float @map("origin_lng")
  destLat   Float @map("dest_lat")
  destLng   Float @map("dest_lng")

  // Route summary (displayed on saved-routes cards)
  mode             String // WALKING | BICYCLING | TRANSIT | MIXED | PLANE | TRAIN
  subType          String? @map("sub_type") // CYCLING_TRANSIT etc.
  distanceKm       Float   @map("distance_km")
  durationMin      Int     @map("duration_min")
  co2Grams         Int     @map("co2_grams")
  savedVsCar       Int     @map("saved_vs_car")
  carEquivalentCO2 Int     @map("car_equivalent_co2")
  carbonScore      Int     @map("carbon_score")
  greenPoints      Int     @map("green_points")
  finalScore       Int     @default(0) @map("final_score")

  // Mood context when route was saved (optional)
  mood       String?
  moodReason String? @map("mood_reason")

  // Full EcoRoute snapshot — contains carbonBreakdown steps + geometry polyline
  // required to reconstruct navigation without re-fetching Google Maps
  routeData Json @map("route_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // One saved entry per user+origin+dest+mode combination.
  // Re-saving updates the route data rather than creating a duplicate.
  @@unique([profileId, originLat, originLng, destLat, destLng, mode])
  @@index([profileId, createdAt(sort: Desc)])
  @@map("saved_routes")
}

// ─────────────────────────────────────────────
// PartnerProfile
// ─────────────────────────────────────────────

model PartnerProfile {
  id            String        @id @default(cuid())
  profileId     String        @unique @map("profile_id")
  businessName  String        @map("business_name")
  businessEmail String?       @map("business_email")
  phone         String?
  location      String?
  logoUrl       String?       @map("logo_url")
  status        PartnerStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  profile  Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  listings MarketplaceListing[]
  orders   MarketplaceOrder[]

  @@map("partner_profiles")
}

// ─────────────────────────────────────────────
// MarketplaceCategory
// ─────────────────────────────────────────────

model MarketplaceCategory {
  id        String @id @default(cuid())
  slug      String @unique
  label     String
  glyph     String @default("🌿")
  sortOrder Int    @default(0) @map("sort_order")

  listings MarketplaceListing[]

  @@map("marketplace_categories")
}

// ─────────────────────────────────────────────
// MarketplaceListing
// ─────────────────────────────────────────────

model MarketplaceListing {
  id          String             @id @default(cuid())
  partnerId   String             @map("partner_id")
  categoryId  String             @map("category_id")
  title       String
  description String?
  whyEco      String?            @map("why_eco")
  type        ListingType        @default(PRODUCT)
  payment     ListingPaymentType @default(FLEXIBLE)
  moneyPrice  Decimal?           @map("money_price") @db.Decimal(10, 2)
  pointsPrice Int?               @map("points_price")
  stock       Int?
  location    String?
  status      ListingStatus      @default(DRAFT)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  partner  PartnerProfile      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  category MarketplaceCategory @relation(fields: [categoryId], references: [id])
  images   MarketplaceImage[]
  orders   MarketplaceOrder[]

  @@index([partnerId])
  @@index([categoryId, status])
  @@map("marketplace_listings")
}

// ─────────────────────────────────────────────
// MarketplaceImage
// ─────────────────────────────────────────────

model MarketplaceImage {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  url       String
  isCover   Boolean  @default(false) @map("is_cover")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("marketplace_images")
}

// ─────────────────────────────────────────────
// MarketplaceOrder
// ─────────────────────────────────────────────

model MarketplaceOrder {
  id                 String                 @id @default(cuid())
  profileId          String                 @map("profile_id")
  partnerId          String                 @map("partner_id")
  listingId          String                 @map("listing_id")
  pointsUsed         Int                    @default(0) @map("points_used")
  moneyPaidSimulated Decimal                @default(0) @map("money_paid_simulated") @db.Decimal(10, 2)
  status             MarketplaceOrderStatus @default(PENDING)
  note               String?
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  profile Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  partner PartnerProfile     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([partnerId])
  @@index([listingId])
  @@map("marketplace_orders")
}
