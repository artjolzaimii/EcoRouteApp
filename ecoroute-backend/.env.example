# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
# Postgres connection string from Supabase → Project Settings → Database → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Found in Supabase → Project Settings → API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Found in Supabase → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ─────────────────────────────────────────────
# Google Maps
# ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ─────────────────────────────────────────────
# Upstash Redis
# ─────────────────────────────────────────────
# Found in Upstash Console → Redis Database → REST API
UPSTASH_REDIS_REST_URL=https://[YOUR-ENDPOINT].upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token-here
